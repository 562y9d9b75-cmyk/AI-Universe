# Copy to .env; scripts/setup.sh creates random local database credentials when absent.
AIU_DATABASE_URL=postgresql+psycopg://aiu:CHANGE_ME@127.0.0.1:55432/aiu
POSTGRES_PASSWORD=CHANGE_ME
AIU_REDIS_URL=redis://127.0.0.1:56379/0
AIU_DATA_DIR=.data
AIU_PORT=8000
AIU_WEB_PORT=3000
AIU_ORIGIN=http://localhost:3000
# No API key or paid-provider fallback is enabled.
